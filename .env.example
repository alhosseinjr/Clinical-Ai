# No API key needed -- this project uses a locally fine-tuned model.
# These are optional overrides; sensible defaults are baked into
# src/utils/llm.py and only apply once you've trained the adapter
# (see finetune/ and the README "Local LLM" section).

# Base model the LoRA adapter was trained on top of.
BASE_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# Where finetune/scripts/train_lora.py saved the adapter.
LORA_ADAPTER_PATH=models/clinical-lora-adapter

# Optional: where finetune/scripts/merge_lora.py saved a merged model.
# If this directory exists, it's used instead of base+adapter.
MERGED_MODEL_PATH=models/clinical-llm-merged
